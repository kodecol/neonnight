# URL pública absoluta del sitio (canonicals, sitemap, OG, JSON-LD)
SITE_URL=http://localhost:3000

# Número de WhatsApp en formato internacional sin "+" (ej. 573001234567).
# Vacío = los enlaces de WhatsApp se renderizan deshabilitados. PENDIENTE de definir.
WHATSAPP_NUMBER=

# Perfiles de redes (sección "Encuéntranos en redes", header y JSON-LD). PENDIENTE confirmar los reales.
INSTAGRAM_URL=https://instagram.com/neonnight
FACEBOOK_URL=https://facebook.com/neonnight
TIKTOK_URL=https://tiktok.com/@neonnight
YOUTUBE_URL=https://youtube.com/@neonnight

# ── Base de datos ────────────────────────────────────────────────────────
# MongoDB (Atlas en producción). Vacío = repositorios en memoria (sin persistencia).
# Local: `npm run db:up` levanta Mongo en Docker → mongodb://localhost:27018
MONGODB_URI=
MONGODB_DB=neonnight

# ── Fotos ────────────────────────────────────────────────────────────────
# cloudinary://<api_key>:<api_secret>@<cloud_name>. Vacío = disco local (.data/uploads, solo desarrollo).
CLOUDINARY_URL=

# ── Panel /admin ─────────────────────────────────────────────────────────
# Contraseña del único administrador.
ADMIN_PASSWORD=
# 32+ caracteres aleatorios: firma la sesión y cifra la llave secreta de Bold.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
