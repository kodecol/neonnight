# URL pública absoluta del sitio (canonicals, sitemap, OG, JSON-LD)
SITE_URL=http://localhost:3000

# Número de WhatsApp en formato internacional sin "+" (ej. 573001234567).
# Vacío = los enlaces de WhatsApp se renderizan deshabilitados. PENDIENTE de definir.
WHATSAPP_NUMBER=

# Perfiles de redes (sección "Síguenos de cerca", header, footer y JSON-LD). Los valores por defecto ya son los reales.
INSTAGRAM_URL=https://www.instagram.com/neonnight01/
FACEBOOK_URL=https://www.facebook.com/neonnightonline/
# Vacío: TikTok no aparece hasta que exista el perfil.
TIKTOK_URL=
YOUTUBE_URL=https://www.youtube.com/NeonNightsChannel

# ── Medición y verificación (opcionales) ─────────────────────────────────
# Con alguno de los dos IDs aparece el banner de cookies; nada se carga sin consentimiento.
GA_MEASUREMENT_ID=
META_PIXEL_ID=
# Códigos de las etiquetas <meta> de Search Console y Meta Business.
GOOGLE_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=

# ── Base de datos ────────────────────────────────────────────────────────
# MongoDB (Atlas en producción). Vacío = repositorios en memoria (sin persistencia).
# Local: `npm run db:up` levanta Mongo en Docker → mongodb://localhost:27018
MONGODB_URI=
MONGODB_DB=neonnight

# ── Fotos ────────────────────────────────────────────────────────────────
# cloudinary://<api_key>:<api_secret>@<cloud_name>. Vacío = disco local (.data/uploads, solo desarrollo).
CLOUDINARY_URL=

# ── Panel /admin ─────────────────────────────────────────────────────────
# Contraseña del único administrador.
ADMIN_PASSWORD=
# 32+ caracteres aleatorios: firma la sesión y cifra la llave secreta de Bold.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
