# /opt/apps/neonnight/.env — variables de runtime de Neon Night (permisos 600).
# Nunca se sube al repo. Se edita en el VPS y se aplica con:
#   cd /opt/apps/neonnight && docker compose up -d --force-recreate web

# URL pública canónica (canonicals, sitemap, OG, retorno del checkout y webhook de Bold)
SITE_URL=https://dominio.com

# MongoDB Atlas (usuario con readWrite solo sobre la base neonnight)
MONGODB_URI=mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=neonnight
MONGODB_DB=neonnight

# Cloudinary (API environment variable del dashboard)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Panel /admin
ADMIN_PASSWORD=
# 32+ caracteres aleatorios. Si se cambia, hay que volver a escribir la llave secreta de Bold en /admin/pagos.
ADMIN_SECRET=

# Contacto y redes (opcionales)
WHATSAPP_NUMBER=
INSTAGRAM_URL=https://instagram.com/neonnight
FACEBOOK_URL=https://facebook.com/neonnight
TIKTOK_URL=https://tiktok.com/@neonnight
YOUTUBE_URL=https://youtube.com/@neonnight
